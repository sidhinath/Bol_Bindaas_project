{
  "name": "bolbindaas",
  "version": "1.0.0",
  "description": "BolBindaas turns Hinglish thoughts into clean, natural English.",
  "private": true,
  "scripts": {
    "start": "python server.py",
    "dev": "python server.py",
    "test": "python -m unittest discover -s tests -p \"test_*.py\" -v && node --test",
    "test:backend": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:frontend": "node --test",
    "test:coverage": "python tests/python_coverage.py && node --test --experimental-test-coverage --test-coverage-exclude=tests/**"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidhinath/Bol_Bindaas_project.git"
  },
  "homepage": "https://github.com/sidhinath/Bol_Bindaas_project#readme",
  "bugs": {
    "url": "https://github.com/sidhinath/Bol_Bindaas_project/issues"
  }
}
