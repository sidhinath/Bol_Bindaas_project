# Copy this file to .env and add at least one provider key. Never commit .env.
# Gemini is the primary provider; the others are optional automatic fallbacks.

# --- Provider selection -----------------------------------------------------
# auto (recommended) tries Gemini first, then Groq, then OpenAI/OpenRouter
# if those optional keys are also present.
# Set one of: auto | gemini | groq | openai | openrouter
AI_PROVIDER=auto

# --- Gemini (primary) -------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# AI_API_KEY and GOOGLE_API_KEY are also accepted for older deployments.
GEMINI_API_KEY=AIza-your-gemini-key-here

# --- Groq (fallback on 429 / 503 / timeout / network error) -----------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# Fastest Gemini tier; slower legacy values are upgraded automatically.
AI_MODEL=gemini-3.5-flash-lite
# Slow legacy values (gemini-3.8-flash / 3.6-flash) are upgraded automatically.
# AI_ALLOW_LEGACY_MODEL=1

# Lighter Gemini model tried if the primary is overloaded (default shown).
# AI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Groq tuning ------------------------------------------------------------
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Optional extra providers -----------------------------------------------
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Retries and diagnostics ------------------------------------------------
# Up to AI_MAX_ATTEMPTS requests per provider with exponential backoff.
# AI_MAX_ATTEMPTS=3
# AI_TIMEOUT_SECONDS=30

# Add raw provider error details to browser responses (logs are always verbose).
# AI_DEBUG=1

# Optional override for the Gemini API base URL.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local development defaults. Hosting platforms set HOST/PORT for you.
HOST=127.0.0.1
PORT=5500
