# Copy this file to .env and fill in your key. Never commit .env.
AI_API_KEY=sk-your-api-key-here

# OpenAI-compatible endpoint. Change only if your provider uses a different URL.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Local development defaults. Hosting platforms set HOST/PORT for you.
HOST=127.0.0.1
PORT=5500
