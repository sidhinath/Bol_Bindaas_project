# Copy this file to .env and add your Gemini API key. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
AI_API_KEY=AIza-your-gemini-key-here

# Gemini model to use (default: gemini-3.5-flash-lite).
AI_MODEL=gemini-3.5-flash-lite

# Lighter model tried if the primary model is overloaded (default shown).
# AI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Retries and timeout. Up to AI_MAX_ATTEMPTS requests with exponential backoff.
# AI_MAX_ATTEMPTS=3
# AI_TIMEOUT_SECONDS=30

# Optional override for the Gemini API base URL.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Add raw Gemini error details to browser responses (logs are always verbose).
# AI_DEBUG=1

# Local development defaults. Hosting platforms set HOST/PORT for you.
HOST=127.0.0.1
PORT=5500
